# Copy to .env and fill in. `docker compose` reads this file automatically.
#   cp .env.example .env

# --- MongoDB ----------------------------------------------------------------
# MONGO_DB must match the database name inside seed/QualityReads.archive.gz.
# Percent-encode the password if it contains any of  @ : / ? # [ ] %
MONGO_USER=qualityreads
MONGO_PASSWORD=change-me-please
MONGO_DB=QualityReads

# --- Redis ------------------------------------------------------------------
# Holds notifications and trending rankings -- this is durable data, not a cache.
REDIS_PASSWORD=change-me-too

# --- Auth.js ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Pins the OAuth callback URL so a reverse-proxy header mistake cannot break login.
AUTH_URL=https://reads.client.dvippatel.in
# From Google Cloud Console > APIs & Services > Credentials.
# The client must list https://reads.client.dvippatel.in/api/auth/callback/google
# as an authorized redirect URI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Host binding -----------------------------------------------------------
# Loopback by default: reach the app through your own reverse proxy.
# Set APP_BIND=0.0.0.0 only if the proxy runs on a different machine.
APP_BIND=127.0.0.1
APP_PORT=3000

TZ=UTC
